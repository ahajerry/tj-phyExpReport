{
  "name": "phyexpcal",
  "private": true,
  "version": "261003.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "backend": "node scripts/backend.mjs --environment development",
    "backend:prod": "node scripts/backend.mjs --environment production",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "version:show": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs",
    "test:backend": "go -C server test ./...",
    "test:experiment-data": "node --experimental-strip-types scripts/test-experiment-data.mjs",
    "test:precision": "node --experimental-strip-types scripts/test-result-precision.mjs",
    "preview": "vite preview",
    "build:backend": "node scripts/backend.mjs --build-only",
    "test:backend:race": "go -C server test -race ./...",
    "test:docker": "node scripts/smoke-docker.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "preinstall": "node scripts/require-pnpm.mjs",
    "test:storage": "node --experimental-strip-types scripts/test-structured-experiment-storage.mjs",
    "test:preview": "node --experimental-strip-types scripts/test-forced-vibration-preview.mjs",
    "test:samples": "node --experimental-strip-types scripts/test-report-page-samples.mjs",
    "dev:docker": "node scripts/dev.mjs --docker",
    "dev:local": "node scripts/dev.mjs --local",
    "dev:setup": "node scripts/dev.mjs --setup",
    "dev:frontend": "vite",
    "test:dev": "node --test --test-isolation=none scripts/test-dev-workflow.mjs",
    "test:dev:docker": "node scripts/smoke-dev.mjs",
    "test:render": "node scripts/test-render.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24",
    "pnpm": "11.28.5"
  }
